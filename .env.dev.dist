# Fichier modèle pour .env.dev (non commité).
# Copiez ce fichier en .env.dev et remplissez les valeurs manquantes.
#
#   cp .env.dev.dist .env.dev
#
# Ces variables surchargent celles de .env pour l'environnement de développement local.

APP_ENV=dev

# Clé secrète de l'application — générez-en une avec :
#   php bin/console secrets:generate-keys
# ou utilisez n'importe quelle chaîne aléatoire de 32+ caractères.
APP_SECRET=
